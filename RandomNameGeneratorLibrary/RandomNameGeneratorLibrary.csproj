<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>RandomNameGeneratorLibrary</PackageId>
    <Version>2.1.0</Version>
    <Authors>Mark Rogers</Authors>
    <Copyright>Copyright (c) 2014-2026 Mark Rogers</Copyright>
    <Title>Random Name Generator</Title>
    <Description>Generates random people and place names drawn from freely available US census data. Create a PersonNameGenerator or PlaceNameGenerator and call a method such as GenerateRandomFirstAndLastName(); every method name says literally what it does.</Description>
    <PackageTags>random;name;generator;census;person;place;fake;test-data</PackageTags>
    <PackageProjectUrl>https://github.com/m4bwav/DotNetRandomNameGenerator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/m4bwav/DotNetRandomNameGenerator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>2.1.0: place list fixed (49 Puerto Rico names had a broken character) and deduplicated so every place is equally likely; default generators no longer repeat each other on .NET Framework (#7); lists parsed lazily and thread-safely; new PersonNameGenerator(int seed) and PlaceNameGenerator(int seed); MaleFirstNames, FemaleFirstNames, LastNames and PlaceNames exposed as read-only lists; XML docs and nullable annotations; CensusListStripper and FileCompressor marked obsolete. Full history: https://github.com/m4bwav/DotNetRandomNameGenerator/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>2.0.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources.dist.all.last.stripped" LogicalName="RandomNameGeneratorLibrary.Resources.dist.all.last.stripped" />
    <EmbeddedResource Include="Resources.dist.female.first.stripped" LogicalName="RandomNameGeneratorLibrary.Resources.dist.female.first.stripped" />
    <EmbeddedResource Include="Resources.dist.male.first.stripped" LogicalName="RandomNameGeneratorLibrary.Resources.dist.male.first.stripped" />
    <EmbeddedResource Include="Resources.places2k.txt.stripped" LogicalName="RandomNameGeneratorLibrary.Resources.places2k.txt.stripped" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
