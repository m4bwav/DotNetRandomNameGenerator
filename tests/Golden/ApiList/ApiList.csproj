<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lists the public API of the PUBLISHED 2.2.0 by reflection, on both builds (net48 loads lib/netstandard2.0).
       Run: dotnet run -c Release -f net48 (or net10.0) with the output path as the argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RandomNameGeneratorLibrary" Version="[2.2.0]" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
